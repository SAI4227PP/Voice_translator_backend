# Dockerfile for model downloader
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ARGOS_PACKAGES_DIR=/app/models/translate/argos-packages

WORKDIR /app

# Install system dependencies for unzipping
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install packages with cache mount AND cleanup in same layer to save space
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install aiohttp tqdm argostranslate && \
    find /usr/local/lib/python3.11 -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11 -type f -name "*.pyc" -delete && \
    rm -rf /tmp/*

# Copy download script
COPY scripts/download_models.py scripts/download_models.py

# Create models directory structure
RUN mkdir -p models/stt models/translate/argos-packages models/tts/coqui-models

# Script will be run via docker-compose command
