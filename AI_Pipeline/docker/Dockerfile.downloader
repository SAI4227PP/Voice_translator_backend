# Dockerfile for model downloader
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies with cache mount
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first (separate layer for caching)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip

# Install Python packages (separate layer for better caching)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install aiohttp tqdm

# Cleanup in final layer
RUN find /usr/local/lib/python3.11 -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.11 -type f -name "*.pyc" -delete && \
    rm -rf /tmp/*

# Copy download script
COPY scripts/download_models.py scripts/download_models.py

# Create models directory structure used by current pipeline
RUN mkdir -p models/stt models/tts/svara

# Script will be run via docker-compose command
