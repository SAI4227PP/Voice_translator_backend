# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Environment
ENVIRONMENT=development
DEBUG=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# WebSocket Configuration
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
MAX_CONNECTIONS=100
MAX_MESSAGE_SIZE=10485760

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=4096
AUDIO_FORMAT=PCM16

# Model Paths
VOSK_MODEL_BASE_PATH=models/stt
VOSK_MODEL_PATH_EN=models/stt/vosk-en
VOSK_MODEL_PATH_HI=models/stt/vosk-hi
VOSK_MODEL_PATH_TE=models/stt/vosk-te
VOSK_MODEL_PATH_TA=models/stt/vosk-ta
VOSK_MODEL_PATH_KN=models/stt/vosk-kn
VOSK_MODEL_PATH_ML=models/stt/vosk-ml
VOSK_MODEL_PATH_GU=models/stt/vosk-gu
VOSK_MODEL_PATH_MR=models/stt/vosk-mr
VOSK_MODEL_PATH_BN=models/stt/vosk-bn

SVARA_TTS_MODEL_ID=kenpath/svara-tts-v1
SVARA_TTS_API_BASE_URL=http://127.0.0.1:8001/v1
SVARA_TTS_API_KEY=
SVARA_TTS_TIMEOUT_SECONDS=90
SVARA_TTS_MAX_INPUT_CHARS=1200
SVARA_TTS_DEFAULT_VOICE=anushka
SVARA_TTS_CPP_BINARY_PATH=/app/app/pipeline/tts/tts_engine
SVARA_TTS_DAEMON_WORKERS=2
SVARA_TTS_DAEMON_QUEUE_SIZE=128
SVARA_TTS_ONNX_MODEL_PATH=
SVARA_TTS_TOKENIZER_ID=kenpath/svara-tts-v1
SVARA_TTS_ONNX_THREADS=1
SVARA_TTS_ONNX_SAMPLE_RATE=24000
TTS_DAEMON_WORKERS=2
ONNX_THREADS=1
ONNX_SAMPLE_RATE=24000

# Pipeline Configuration
STT_ENGINE=vosk
TRANSLATION_ENGINE=sarvam
TTS_ENGINE=svara
SARVAM_MODEL_PATH=/app/llm-models/sarvam-1-q4.gguf
SARVAM_CPP_BINARY_PATH=/app/app/pipeline/translate/translate_engine
SARVAM_MAX_CONCURRENT_PROCESSES=1
SARVAM_DAEMON_WORKERS=2
SARVAM_DAEMON_QUEUE_SIZE=256
SARVAM_MAX_INPUT_CHARS=4000
SARVAM_GPU_LAYERS=0
LLAMA_SERVER_PORT=8089
TRANSLATION_RETRY_COUNT=2
TRANSLATION_RETRY_BACKOFF_MS=250
TRANSLATION_CIRCUIT_BREAKER_THRESHOLD=5
TRANSLATION_CIRCUIT_BREAKER_RESET_SECONDS=30
LLAMA_CPP_PATH=/app/llama.cpp
LLAMA_CLI_PATH=/app/llama.cpp/bin/llama-cli

# TTS Configuration
# Svara OpenAI-compatible inference endpoint

# =============================================================================
# NLLB TRANSLATION CONFIGURATION (NEW)
# =============================================================================
# Model options: 
#   - facebook/nllb-200-distilled-600M (600MB - Recommended, fast)
#   - facebook/nllb-200-1.3B (1.3GB - Better quality)
#   - facebook/nllb-200-3.3B (3.3GB - Best quality, slower)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
NLLB_CACHE_DIR=models/translate/nllb-cache

# Enable GPU (required for best performance)
ENABLE_GPU=true

# FP16 for 2-3x speed boost (recommended)
NLLB_USE_HALF_PRECISION=true

# 8-bit quantization for low memory (optional)
NLLB_USE_QUANTIZATION=false

# Compile model for extra 10-20% speed (optional)
NLLB_COMPILE_MODEL=false
# Performance Tuning
WORKER_THREADS=2
BUFFER_SIZE=8192
QUEUE_SIZE=100

# Room Configuration
MAX_USERS_PER_ROOM=10
ROOM_TIMEOUT=3600
IDLE_TIMEOUT=300

# Security
ENABLE_AUTH=False
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
RATE_LIMIT_PER_MINUTE=60

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# CORS
CORS_ORIGINS=*
HF_TOKEN=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

# Database (Optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/voicetranslator

# Redis (Optional - for scaling)
