{
  "info": {
    "_postman_id": "voice-translator-api-collection",
    "name": "Voice-to-Voice Translator API",
    "description": "REST collection aligned with current Go server implementation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.1.0"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Root",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Server Stats",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/stats",
              "host": ["{{base_url}}"],
              "path": ["stats"]
            }
          }
        },
        {
          "name": "Runtime Config",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/config",
              "host": ["{{base_url}}"],
              "path": ["config"]
            }
          }
        }
      ]
    },
    {
      "name": "Languages",
      "item": [
        {
          "name": "Supported Languages",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/languages/supported",
              "host": ["{{base_url}}"],
              "path": ["languages", "supported"]
            }
          }
        },
        {
          "name": "Translation Pairs",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/languages/pairs",
              "host": ["{{base_url}}"],
              "path": ["languages", "pairs"]
            }
          }
        }
      ]
    },
    {
      "name": "Translation",
      "item": [
        {
          "name": "Translate Text",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you?\",\n  \"source_language\": \"en\",\n  \"target_language\": \"hi\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/translate",
              "host": ["{{base_url}}"],
              "path": ["translate"]
            }
          }
        },
        {
          "name": "Batch Translate",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": [\"Hello\", \"How are you?\", \"Thanks\"],\n  \"source_language\": \"en\",\n  \"target_language\": \"hi\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/translate/batch",
              "host": ["{{base_url}}"],
              "path": ["translate", "batch"]
            }
          }
        }
      ]
    },
    {
      "name": "Text-to-Speech",
      "item": [
        {
          "name": "Generate TTS (Unary)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, this is a test message\",\n  \"language\": \"en\",\n  \"format\": \"wav\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tts/generate",
              "host": ["{{base_url}}"],
              "path": ["tts", "generate"]
            }
          }
        },
        {
          "name": "Generate TTS (HTTP Stream Relay)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, this is streamed audio\",\n  \"language\": \"en\",\n  \"format\": \"wav\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/tts/generate?stream=true",
              "host": ["{{base_url}}"],
              "path": ["tts", "generate"],
              "query": [
                { "key": "stream", "value": "true" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Translate + TTS",
      "item": [
        {
          "name": "Translate then TTS (Unary)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you?\",\n  \"source_language\": \"en\",\n  \"target_language\": \"hi\",\n  \"mode\": \"full_sentence\",\n  \"format\": \"wav\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/translate-tts",
              "host": ["{{base_url}}"],
              "path": ["translate-tts"]
            }
          }
        },
        {
          "name": "Translate then TTS (HTTP Stream Relay)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is a streaming pipeline test\",\n  \"source_language\": \"en\",\n  \"target_language\": \"hi\",\n  \"mode\": \"full_sentence\",\n  \"format\": \"wav\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/translate-tts?stream=true",
              "host": ["{{base_url}}"],
              "path": ["translate-tts"],
              "query": [
                { "key": "stream", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Translate then TTS (Chunk Mode)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"hello chunk\",\n  \"source_language\": \"en\",\n  \"target_language\": \"hi\",\n  \"mode\": \"chunk\",\n  \"stream_id\": \"demo-stream-1\",\n  \"format\": \"wav\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/translate-tts",
              "host": ["{{base_url}}"],
              "path": ["translate-tts"]
            }
          }
        }
      ]
    },
    {
      "name": "Speech-to-Text",
      "item": [
        {
          "name": "STT Transcribe (Base64)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio_data\": \"<BASE64_AUDIO>\",\n  \"language\": \"en\",\n  \"sample_rate\": 16000,\n  \"return_confidence\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/stt/transcribe",
              "host": ["{{base_url}}"],
              "path": ["stt", "transcribe"]
            }
          }
        },
        {
          "name": "STT Transcribe File",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "language", "value": "en", "type": "text" },
                { "key": "return_confidence", "value": "true", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/stt/transcribe-file",
              "host": ["{{base_url}}"],
              "path": ["stt", "transcribe-file"]
            }
          }
        },
        {
          "name": "STT Transcribe Batch",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio_files\": [\"<BASE64_AUDIO_1>\", \"<BASE64_AUDIO_2>\"],\n  \"language\": \"en\",\n  \"sample_rate\": 16000,\n  \"return_confidence\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/stt/transcribe-batch",
              "host": ["{{base_url}}"],
              "path": ["stt", "transcribe-batch"]
            }
          }
        }
      ]
    }
  ]
}
