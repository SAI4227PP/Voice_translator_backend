# Voice-to-Voice Translator - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENVIRONMENT=development
DEBUG=False

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
MAX_CONNECTIONS=100
MAX_MESSAGE_SIZE=10485760

# =============================================================================
# AUDIO CONFIGURATION
# =============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=4096
AUDIO_FORMAT=PCM16

# =============================================================================
# MODEL PATHS
# =============================================================================
VOSK_MODEL_BASE_PATH=models/stt
VOSK_MODEL_PATH_EN=models/stt/vosk-en
VOSK_MODEL_PATH_HI=models/stt/vosk-hi
VOSK_MODEL_PATH_TE=models/stt/vosk-te
VOSK_MODEL_PATH_TA=models/stt/vosk-ta
VOSK_MODEL_PATH_KN=models/stt/vosk-kn
VOSK_MODEL_PATH_ML=models/stt/vosk-ml
VOSK_MODEL_PATH_GU=models/stt/vosk-gu
VOSK_MODEL_PATH_MR=models/stt/vosk-mr
VOSK_MODEL_PATH_BN=models/stt/vosk-bn

SVARA_TTS_MODEL_ID=kenpath/svara-tts-v1
SVARA_TTS_API_BASE_URL=http://127.0.0.1:8001/v1
SVARA_TTS_API_KEY=
SVARA_TTS_TIMEOUT_SECONDS=90
SVARA_TTS_MAX_INPUT_CHARS=1200
SVARA_TTS_DEFAULT_VOICE=anushka
SVARA_TTS_CPP_BINARY_PATH=/app/app/pipeline/tts/tts_engine
SVARA_TTS_DAEMON_WORKERS=2
SVARA_TTS_DAEMON_QUEUE_SIZE=128
SVARA_TTS_ONNX_MODEL_PATH=
SVARA_TTS_TOKENIZER_ID=kenpath/svara-tts-v1
SVARA_TTS_ONNX_THREADS=1
SVARA_TTS_ONNX_SAMPLE_RATE=24000
TTS_DAEMON_WORKERS=2
ONNX_THREADS=1
ONNX_SAMPLE_RATE=24000

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================
STT_ENGINE=vosk
TRANSLATION_ENGINE=sarvam
TTS_ENGINE=svara
SARVAM_MODEL_PATH=/app/llm-models/sarvam-1-q4.gguf
SARVAM_CPP_BINARY_PATH=/app/app/pipeline/translate/translate_engine
SARVAM_MAX_CONCURRENT_PROCESSES=1
SARVAM_DAEMON_WORKERS=2
SARVAM_DAEMON_QUEUE_SIZE=256
SARVAM_MAX_INPUT_CHARS=4000
SARVAM_GPU_LAYERS=0
LLAMA_SERVER_PORT=8089
TRANSLATION_RETRY_COUNT=2
TRANSLATION_RETRY_BACKOFF_MS=250
TRANSLATION_CIRCUIT_BREAKER_THRESHOLD=5
TRANSLATION_CIRCUIT_BREAKER_RESET_SECONDS=30
LLAMA_CPP_PATH=/app/llama.cpp
LLAMA_CLI_PATH=/app/llama.cpp/bin/llama-cli

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
ENABLE_GPU=False
WORKER_THREADS=2
BUFFER_SIZE=8192
QUEUE_SIZE=100

# =============================================================================
# ROOM CONFIGURATION
# =============================================================================
MAX_USERS_PER_ROOM=10
ROOM_TIMEOUT=3600
IDLE_TIMEOUT=300

# =============================================================================
# SECURITY
# =============================================================================
ENABLE_AUTH=False
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# API Keys (comma-separated)
API_KEYS=

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
MAX_REQUESTS_PER_MINUTE=100
MAX_CONNECTIONS_PER_IP=10
MAX_MESSAGES_PER_SECOND=10

# =============================================================================
# WORKER POOLS
# =============================================================================
TRANSLATION_WORKERS=4
TTS_WORKERS=2

# =============================================================================
# WARM START CONFIGURATION (Performance Optimization)
# =============================================================================
# STT (Speech-to-Text) Warm Start
# Preload STT models at startup to eliminate cold start delays
STT_ENABLE_WARM_START=true
STT_PRELOAD_LANGUAGES=en,hi

# Translation Warm Start
# Preload translation models at startup
TRANSLATION_ENABLE_WARM_START=true
TRANSLATION_WARM_START_MODE=common
# Common translation pairs (format: src-tgt, comma-separated)
TRANSLATION_COMMON_PAIRS=en-hi,hi-en,en-bn,bn-en

# TTS (Text-to-Speech) Warm Start
# Preload TTS models at startup to eliminate cold start delays
TTS_ENABLE_WARM_START=true
TTS_PRELOAD_LANGUAGES=en,hi,ta,bn

# =============================================================================
# MONITORING
# =============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=*

# =============================================================================
# OPTIONAL: DATABASE
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/voice_translator

# =============================================================================
# OPTIONAL: REDIS
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# =============================================================================
# DOCKER COMPOSE OVERRIDES
# =============================================================================
# Uncomment and modify for production deployment
# GRAFANA_PASSWORD=secure_password_here




